{
  "name": "dental-clinic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.22.3",
    "framer-motion": "^11.11.17",
    "mongoose": "^8.24.11",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22"
  }
}
